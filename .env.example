# Copy to .env and fill in. Never commit .env.
# Make a key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# development on your laptop, production on the server
FLASK_ENV=development
DEBUG=0
DATABASE_PATH=instance/ajora.db
# memory:// for one worker; redis://host:6379/0 for several workers
RATELIMIT_STORAGE_URI=memory://
LOG_DIR=logs
# Minutes
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
# Password for all seeded demo customers (required by `flask --app wsgi seed`)
DEMO_PASSWORD=
# 1 only when running behind our own reverse proxy (e.g. PythonAnywhere), so it
# trusts exactly one hop of X-Forwarded-For/X-Forwarded-Proto. 0 (default):
# never trust those headers, since any client could otherwise spoof its IP
# for rate limiting.
TRUSTED_PROXY_COUNT=0
